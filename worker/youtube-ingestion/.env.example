# Copy to .env (gitignored) for local runs, or set these as real secrets in
# whatever container platform hosts this worker. Never commit real values.

# Long random shared secret. The Next.js central import service sends this
# in the X-Worker-Secret header on every /ingest call. Generate with e.g.
# `openssl rand -hex 32`. Required -- the worker refuses all /ingest
# requests if this is unset (fails closed, see src/auth.mjs).
WORKER_SHARED_SECRET=

PORT=8080
WHISPER_MODEL=tiny
