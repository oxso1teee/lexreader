{
  "manifest_version": 3,
  "name": "LexReader YouTube Bridge",
  "version": "2.0.0",
  "description": "YouTube-субтитры для LexReader + тап-перевод слова в контексте на любой странице.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://lexreader.vercel.app/*",
    "https://lexreader.app/*",
    "https://www.lexreader.app/*",
    "https://lexreader-focoqdkq7-meeeee4.vercel.app/*",
    "https://lexreader-mnzvtftfs-meeeee4.vercel.app/*",
    "https://lexreader-ctoczfjdx-meeeee4.vercel.app/*",
    "https://lexreader-1zg3zf2nv-meeeee4.vercel.app/*",
    "https://lexreader-he4dnhye3-meeeee4.vercel.app/*",
    "https://lexreader-git-feature-import-video-reader-v2-meeeee4.vercel.app/*",
    "https://lexreader-28rlw6ouq-meeeee4.vercel.app/*",
    "https://lexreader-4ospe4xo4-meeeee4.vercel.app/*",
    "https://lexreader-jce7n4yyh-meeeee4.vercel.app/*",
    "https://lexreader-ktigrnw57-meeeee4.vercel.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lexreader.vercel.app/*",
        "https://lexreader.app/*",
        "https://www.lexreader.app/*",
        "https://lexreader-focoqdkq7-meeeee4.vercel.app/*",
        "https://lexreader-mnzvtftfs-meeeee4.vercel.app/*",
        "https://lexreader-ctoczfjdx-meeeee4.vercel.app/*",
        "https://lexreader-1zg3zf2nv-meeeee4.vercel.app/*",
        "https://lexreader-he4dnhye3-meeeee4.vercel.app/*",
        "https://lexreader-git-feature-import-video-reader-v2-meeeee4.vercel.app/*",
        "https://lexreader-28rlw6ouq-meeeee4.vercel.app/*",
        "https://lexreader-4ospe4xo4-meeeee4.vercel.app/*",
        "https://lexreader-jce7n4yyh-meeeee4.vercel.app/*",
        "https://lexreader-ktigrnw57-meeeee4.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "lexreader-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://youtube.com/watch*"
      ],
      "js": [
        "youtube-page-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://youtube.com/watch*"
      ],
      "js": [
        "youtube-dom-extractor.js",
        "youtube-content-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "LexReader — тап-перевод и YouTube-мост",
    "default_popup": "popup.html"
  }
}
