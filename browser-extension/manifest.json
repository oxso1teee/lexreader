{
  "manifest_version": 3,
  "name": "LexReader YouTube Bridge",
  "version": "2.0.0",
  "description": "Загружает субтитры YouTube через браузер пользователя и передаёт их в LexReader.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lexreader.vercel.app/*",
        "https://lexreader.app/*",
        "https://www.lexreader.app/*",
        "https://lexreader-focoqdkq7-meeeee4.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "lexreader-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://youtube.com/watch*"
      ],
      "js": [
        "youtube-page-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://youtube.com/watch*"
      ],
      "js": [
        "youtube-content-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "LexReader YouTube Bridge"
  }
}
