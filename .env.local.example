# Supabase — project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Только для серверных операций, требующих обхода RLS (например, системные тексты).
# Никогда не использовать на клиенте.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push — сгенерировать один раз:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@example.com

# Секрет для /api/cron/push-reminders (см. vercel.json) — Vercel Cron
# автоматически шлёт Authorization: Bearer $CRON_SECRET, если переменная
# задана в настройках проекта. Сгенерировать: openssl rand -hex 32
CRON_SECRET=

# Секрет для /api/health/translate (см. docs/OBSERVABILITY.md) — уптайм-монитор
# должен слать Authorization: Bearer $HEALTH_CHECK_SECRET. Сгенерировать:
# openssl rand -hex 32
HEALTH_CHECK_SECRET=

# Реальная оплата подписки — см. docs/BILLING_SUPPORT.md для полной
# инструкции по настройке (нужен собственный Stripe-аккаунт). Пока пусто —
# /pricing использует локальную тестовую кнопку вместо реального Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Реальный домен продакшена (для success/cancel редиректов Stripe Checkout и
# Customer Portal). Локально по умолчанию http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Импорт субтитров YouTube (library/youtube-actions.ts): без ключа запрос
# страницы видео идёт напрямую и может упереться в антибот-блокировку
# YouTube для IP облачных серверов ("нет открытых субтитров" даже у видео,
# где они есть). ScraperAPI (scraperapi.com, есть бесплатный тариф) — прокси
# с ротацией не-датацентровых IP именно для этого запроса. Пусто — фича
# работает как раньше, на свой страх и риск.
SCRAPERAPI_KEY=

# Продуктовая аналитика (PostHog, free tier до 1M событий/мес) —
# posthog.com → Project Settings → Project API Key. Host зависит от региона
# проекта: https://us.i.posthog.com или https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# M2 Learning Upgrade — rollout-флаги миграции SRS на ts-fsrs
# (docs/learning/fsrs-rollout.md, docs/learning/fsrs-schema-compatibility.md).
# Server-side only, не NEXT_PUBLIC — читаются только из server actions/
# page.tsx через src/lib/fsrs-flags.ts (getFsrsFlags), клиент не может их
# подделать. Два отдельных флага, не один — намеренно:
#
# FSRS_SCHEMA_READY — подтверждение, что migration 0032_fsrs_state.sql
# ПРИМЕНЕНА к текущей БД. Пусто/что угодно кроме точной строки "true" ->
# fsrs_*-колонки и review_log.scheduler_type/previous_state_json/
# next_state_json вообще не запрашиваются и не пишутся (безопасно даже
# против БД без этих колонок — именно это защищает деплой кода до миграции).
# "true" -> можно читать/писать shadow-состояние FSRS.
FSRS_SCHEMA_READY=

# FSRS_ENABLED — кого считать авторитетным для due_at. Работает только
# вместе с FSRS_SCHEMA_READY=true (см. getFsrsFlags: enabled = schemaReady
# && FSRS_ENABLED==="true") — FSRS_ENABLED=true при FSRS_SCHEMA_READY=false
# намеренно игнорируется (safe by construction, не опасная конфигурация).
# Пусто/что угодно кроме "true" -> старый SM-2 остаётся авторитетным для
# due_at (безопасное значение по умолчанию). "true" -> due_at считает
# ts-fsrs. См. src/lib/fsrs.ts (isFsrsEnabled) и src/lib/fsrs-flags.ts.
FSRS_ENABLED=
